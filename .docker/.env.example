# Copy to .env and adjust as needed. .env is gitignored.

# Joomla image tag. Default matches this module's primary target platform.
# For a disposable second instance against bleeding-edge Joomla, use e.g.
# 6.2-php8.5-apache (check hub.docker.com/_/joomla/tags for what exists).
JOOMLA_TAG=6.1-php8.4-apache

# Admin login for http://cuterweblinks.localhost/administrator/
JOOMLA_ADMIN_USERNAME=admin
JOOMLA_ADMIN_PASSWORD=admin12345678
JOOMLA_ADMIN_EMAIL=dev@cuterweblinks.localhost

# Database (container-internal host is always "db")
DB_NAME=joomla
DB_USER=joomla
DB_PASSWORD=joomla
DB_ROOT_PASSWORD=root

# Host ports (fallbacks only; normal access is via the dev-proxy Traefik)
HTTP_PORT=8092
DB_PORT=3312
